<Window x:Class="NeedZones.SyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sync in-game time"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        FontFamily="{DynamicResource BodyFont}" FontSize="{DynamicResource Fs}"
        Foreground="{DynamicResource FgBrush}" UseLayoutRounding="True">
  <Border Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource BorderBrushC}"
          BorderThickness="1" CornerRadius="10" Padding="16,14" MinWidth="280">
    <StackPanel>
      <TextBlock Text="Enter current time - 24h Format" FontWeight="SemiBold"/>
      <Border x:Name="EditBorder" Margin="0,10,0,0" Width="140" HorizontalAlignment="Left"
              Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource AccentBrush}"
              BorderThickness="1" CornerRadius="6" Padding="10,4">
        <Grid>
          <TextBlock x:Name="Placeholder" Text="HH:MM" Foreground="{DynamicResource Dim2Brush}"
                     FontSize="{DynamicResource FsEdit}" FontWeight="SemiBold" IsHitTestVisible="False"/>
          <TextBox x:Name="TimeBox" Background="Transparent" BorderThickness="0" Padding="0"
                   Foreground="{DynamicResource FgBrush}" CaretBrush="{DynamicResource FgBrush}"
                   SelectionBrush="{DynamicResource AccentBrush}"
                   FontSize="{DynamicResource FsEdit}" FontWeight="SemiBold" MaxLength="5"
                   PreviewTextInput="TimeBox_PreviewTextInput" PreviewKeyDown="TimeBox_PreviewKeyDown"
                   TextChanged="TimeBox_TextChanged"/>
        </Grid>
      </Border>
      <TextBlock x:Name="ErrorText" Foreground="{DynamicResource WarnBrush}" FontSize="{DynamicResource FsXs}"
                 Margin="0,6,0,0" TextWrapping="Wrap"/>
      <TextBlock x:Name="HotkeyTip" Foreground="{DynamicResource DimBrush}" FontSize="{DynamicResource FsXs}"
                 Margin="0,0,0,0" TextWrapping="Wrap" MaxWidth="260" HorizontalAlignment="Left"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Margin="0,0,8,0"/>
        <Button Content="Sync" Style="{StaticResource PrimaryButton}" Click="Sync_Click"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
