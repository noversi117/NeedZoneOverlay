<Application x:Class="NeedZones.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>

    <!-- Defaults; Theme.Apply replaces these at startup and on theme / text-size changes -->
    <SolidColorBrush x:Key="BgBrush" Color="#14171b"/>
    <SolidColorBrush x:Key="Bg2Brush" Color="#232931"/>
    <SolidColorBrush x:Key="FgBrush" Color="#e6e6e6"/>
    <SolidColorBrush x:Key="DimBrush" Color="#a4abb4"/>
    <SolidColorBrush x:Key="Dim2Brush" Color="#8a9099"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#e8b04b"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#e07a5f"/>
    <SolidColorBrush x:Key="BorderBrushC" Color="#3a424c"/>
    <SolidColorBrush x:Key="LineBrush" Color="#1f252c"/>
    <SolidColorBrush x:Key="HeadLineBrush" Color="#2b323a"/>
    <SolidColorBrush x:Key="FootBrush" Color="#1a1e23"/>
    <SolidColorBrush x:Key="BoxBrush" Color="#5b636d"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#1fffffff"/>
    <SolidColorBrush x:Key="NextTimesBrush" Color="#8f959d"/>
    <sys:Double x:Key="Fs">13</sys:Double>
    <sys:Double x:Key="FsSm">12</sys:Double>
    <sys:Double x:Key="FsXs">11</sys:Double>
    <sys:Double x:Key="FsTitle">17</sys:Double>
    <sys:Double x:Key="FsMap">16</sys:Double>
    <sys:Double x:Key="FsTime">21</sys:Double>
    <sys:Double x:Key="FsEdit">18</sys:Double>
    <GridLength x:Key="ColW">118</GridLength>
    <FontFamily x:Key="BodyFont">./fonts/#Inter, Segoe UI</FontFamily>
    <FontFamily x:Key="TitleFont">./fonts/#Barlow Condensed, Bahnschrift SemiBold Condensed, Bahnschrift</FontFamily>

    <!-- Tooltips -->
    <Style TargetType="ToolTip">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource BorderBrushC}"
                    BorderThickness="1" CornerRadius="6" Padding="8,4">
              <ContentPresenter TextElement.Foreground="{DynamicResource FgBrush}"
                                TextElement.FontSize="{DynamicResource FsXs}"
                                TextElement.FontFamily="{DynamicResource BodyFont}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Title-bar icon buttons -->
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Line icon drawn with a Path inside a 16x16 box -->
    <Style x:Key="IconPath" TargetType="Path">
      <Setter Property="Width" Value="15"/>
      <Setter Property="Height" Value="15"/>
      <Setter Property="Stretch" Value="None"/>
      <Setter Property="StrokeThickness" Value="1.4"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      <Setter Property="RenderTransformOrigin" Value="0,0"/>
      <Setter Property="RenderTransform">
        <Setter.Value>
          <ScaleTransform ScaleX="0.9375" ScaleY="0.9375"/>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Outlined "Select Map" button -->
    <Style x:Key="MapButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
      <Setter Property="FontSize" Value="{DynamicResource FsSm}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrushC}"
                    BorderThickness="1" CornerRadius="6" Padding="8,4,6,4">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dim2Brush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Pills in the settings popup -->
    <Style x:Key="PillBase" TargetType="ButtonBase">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
      <Setter Property="FontSize" Value="{DynamicResource FsSm}"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <Style x:Key="Pill" TargetType="Button" BasedOn="{StaticResource PillBase}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrushC}"
                    BorderThickness="1" CornerRadius="6" Padding="10,3">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dim2Brush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TogglePill" TargetType="ToggleButton" BasedOn="{StaticResource PillBase}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="bd" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrushC}"
                    BorderThickness="1" CornerRadius="6" Padding="10,3">
              <ContentPresenter x:Name="cp" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dim2Brush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource BgBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Dialog buttons -->
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource BgBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="16,6">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent" BorderBrush="{DynamicResource BorderBrushC}"
                    BorderThickness="1" CornerRadius="6" Padding="14,6">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dim2Brush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Rounded square checkbox: filled accent with a tick when checked -->
    <Style TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="13" Height="13" CornerRadius="3" BorderThickness="1.5"
                      BorderBrush="{DynamicResource BoxBrush}" Background="Transparent" VerticalAlignment="Center">
                <Path x:Name="tick" Data="M1.5,5.2 L4,7.6 L8.6,2.6" Stroke="{DynamicResource BgBrush}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ContentPresenter x:Name="content" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="content" Property="Margin" Value="0"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource DimBrush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Thin rounded scrollbar -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="{DynamicResource BorderBrushC}" CornerRadius="3"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="MinWidth" Value="6"/>
      <Setter Property="Margin" Value="4,2,0,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb Style="{StaticResource ThumbStyle}" MinHeight="24"/>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Rounded menus (Select Map) -->
    <Style TargetType="ContextMenu">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource BorderBrushC}"
                    BorderThickness="1" CornerRadius="8" Padding="4">
              <StackPanel IsItemsHost="True"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
      <Setter Property="FontSize" Value="{DynamicResource FsSm}"/>
      <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="bd" Background="Transparent" CornerRadius="5" Padding="10,6,16,6">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource BgBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Small text styles -->
    <Style x:Key="ColHead" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
      <Setter Property="FontSize" Value="{DynamicResource FsXs}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="PopLabel" TargetType="TextBlock" BasedOn="{StaticResource ColHead}">
      <Setter Property="Width" Value="84"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

  </Application.Resources>
</Application>
