<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>NeedZoneOverlay</AssemblyName>
    <RootNamespace>NeedZones</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <!-- Lets a self-contained single-file exe run on its own (WPF's native DLLs go inside the exe) -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Need-time data and the tray icon sit next to the exe so they can be edited without rebuilding -->
    <Content Include="data\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="icon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Fonts are compiled into the exe -->
    <Resource Include="fonts\*.otf" />
    <Resource Include="fonts\*.ttf" />
  </ItemGroup>

</Project>
